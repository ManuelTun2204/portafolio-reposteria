# Copia este archivo a .env y cambia los valores.
# .env NO se sube a git (esta en .gitignore).

# Nombre que aparece en la tienda.
MARCA=Dulce Atelier

# WhatsApp para confirmar pedidos. Solo digitos, con lada de pais.
# Ejemplo Mexico: 529991112222
WHATSAPP=

# Donde se recogen los pedidos. Se muestra en el checkout y en el pie del sitio.
DIRECCION_TALLER=

# Pago por transferencia (opcional). Si CLABE queda vacia, la tienda NO inventa
# datos bancarios: solo pide acordar el pago por WhatsApp.
BANCO=
TITULAR=
CLABE=

# Anticipo para apartar, en porcentaje del total. 0 = se cobra todo al entregar.
# Ejemplo: 50 pide la mitad por transferencia y la otra mitad al entregar.
ANTICIPO_PORCENTAJE=0

# Contrasena del panel /admin. Cambiala antes de publicar el sitio.
ADMIN_PASSWORD=admin123

# Clave para firmar la cookie de sesion. Genera una cadena larga y aleatoria.
# En PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
SECRET_KEY=cambiar-esta-clave-en-produccion
